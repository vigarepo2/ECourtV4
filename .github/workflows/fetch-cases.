name: Fetch eCourts Cases

on:
  workflow_dispatch:
    inputs:
      force_refresh:
        description: "Re-fetch already completed CNRs"
        required: false
        type: boolean
        default: false
      workers:
        description: "Concurrent eCourts sessions (1-6)"
        required: true
        type: string
        default: "3"
      max_attempts:
        description: "Attempts per unfinished CNR"
        required: true
        type: string
        default: "8"
      boot_attempts:
        description: "Session/bootstrap attempts"
        required: true
        type: string
        default: "8"
  schedule:
    - cron: "30 0 * * *" # 06:00 Asia/Kolkata

permissions:
  contents: write

concurrency:
  group: ecourts-v4-fetch
  cancel-in-progress: false

jobs:
  fetch:
    name: Resume unfinished eCourts CNRs
    runs-on: ubuntu-latest
    timeout-minutes: 180
    env:
      PYTHONUNBUFFERED: "1"
      ECOURTS_FORCE_REFRESH: ${{ github.event_name == 'workflow_dispatch' && inputs.force_refresh || 'false' }}
      ECOURTS_WORKERS: ${{ github.event_name == 'workflow_dispatch' && inputs.workers || '3' }}
      ECOURTS_MAX_ATTEMPTS: ${{ github.event_name == 'workflow_dispatch' && inputs.max_attempts || '8' }}
      ECOURTS_BOOT_ATTEMPTS: ${{ github.event_name == 'workflow_dispatch' && inputs.boot_attempts || '8' }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependency
        run: python -m pip install --disable-pip-version-check -q pycryptodome

      - name: Show resume state
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          master=json.loads(Path('cnr.json').read_text())
          pending=Path('state/pending.json')
          if pending.exists():
              p=json.loads(pending.read_text()).get('pending',[])
              print(f'Master CNRs: {len(master)} | Previous pending: {len(p)}')
          else:
              print(f'Master CNRs: {len(master)} | No saved state yet')
          PY

      - name: Fetch unresolved CNRs — live
        id: fetch
        run: python -u fetchcases.py

      - name: Commit case data and resume state
        if: always()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          if git diff --cached --quiet; then
            echo "No generated changes to commit."
          else
            echo "Generated changes:"
            git diff --cached --name-status
            git commit -m "Update eCourts case progress"
            git pull --rebase origin main
            git push origin HEAD:main
          fi

      - name: Write Actions summary
        if: always()
        run: |
          python - <<'PY' >> "$GITHUB_STEP_SUMMARY"
          import json
          from pathlib import Path
          print('## eCourts fetch status')
          p=Path('state/pending.json')
          c=Path('state/completed.json')
          if c.exists():
              d=json.loads(c.read_text())
              print(f"- Completed: **{d.get('total_completed',0)} / {d.get('master_total',0)}**")
          if p.exists():
              d=json.loads(p.read_text())
              print(f"- Pending: **{d.get('total_pending',0)}**")
              for cnr in d.get('pending',[])[:20]: print(f"  - `{cnr}`")
          print('- Source list: `cnr.json`')
          print('- Individual cases: `cnr/all/<CNR>.json`')
          print('- Daily history: `logs/YYYY-MM-DD.json`')
          PY

      - name: Verify completion
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          p=Path('state/pending.json')
          if not p.exists(): raise SystemExit('state/pending.json was not generated')
          data=json.loads(p.read_text())
          pending=data.get('pending',[])
          if pending:
              print(f'{len(pending)} CNR(s) still pending. They are preserved for the next run.')
              for cnr in pending[:30]: print('-',cnr)
              raise SystemExit(1)
          print('All CNRs complete.')
          PY
